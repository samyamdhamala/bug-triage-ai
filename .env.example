# Postgres (free tier: create a project at supabase.com, copy the connection
# string from Project Settings -> Database -> Connection string -> URI, and
# swap its "postgresql://" prefix for "postgresql+psycopg://")
DATABASE_URL=postgresql+psycopg://postgres:your-password@your-project.supabase.co:5432/postgres

# Encrypts stored Jira/Slack credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key_here

# Signs login sessions (JWT). Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_generated_jwt_secret_here
JWT_EXPIRES_MINUTES=10080

# Used only by scripts/seed_default_org.py and the Slack bot process (slack_bot.py) —
# neither goes through POST /auth/login, so they still need a fixed org to act as.
# The HTTP API (/triage, /integrations/*/connect) resolves org_id from the logged-in
# user instead; sign up via POST /auth/signup rather than setting this for API use.
DEFAULT_ORG_SLUG=default

LLM_PROVIDER=ollama
# Options: openai, groq, gemini, ollama

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Groq (optional)
GROQ_API_KEY=your_groq_api_key_here

# Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Slack Bot — the running process (slack_bot.py) still authenticates as this
# single hardcoded workspace via Socket Mode. SLACK_OAUTH_* below lets orgs
# install the app and stores their bot token, but the bot process itself
# doesn't yet serve multiple installed workspaces from that storage — see the
# README's Slack section.
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BUGS_CHANNEL=bugs

# Slack — OAuth v2 ("Add to Slack"). Create an app at https://api.slack.com/apps
# -> OAuth & Permissions -> add bot scopes: channels:history, channels:read,
# chat:write, commands. Set the redirect URL to match SLACK_OAUTH_REDIRECT_URI.
# Then connect an org by visiting (while logged in as that org):
#   GET /integrations/slack/connect?bugs_channel=bugs
SLACK_OAUTH_CLIENT_ID=your_slack_oauth_client_id
SLACK_OAUTH_CLIENT_SECRET=your_slack_oauth_client_secret
SLACK_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/slack/callback

# Jira — classic auth (used by scripts/seed_default_org.py). Fine for a single
# org, but the API token has no refresh mechanism: it just dies eventually
# (revoked, rotated, expired) with no warning. Prefer the OAuth vars below for
# anything meant to keep running unattended.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=BT

# Jira — OAuth 2.0 (3LO), self-refreshing. Register an app at
# https://developer.atlassian.com/console/myapps/ -> "Authorization" tab ->
# add the "Jira API" permission with scopes read:jira-work, write:jira-work,
# offline_access. Set its callback URL to match JIRA_OAUTH_REDIRECT_URI below.
# Then connect an org by visiting (while logged in as that org):
#   GET /integrations/jira/connect?project_key=BT
JIRA_OAUTH_CLIENT_ID=your_atlassian_oauth_client_id
JIRA_OAUTH_CLIENT_SECRET=your_atlassian_oauth_client_secret
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/jira/callback

# Signs the short-lived OAuth state token (CSRF protection for the connect flow).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=your_generated_random_secret_here
