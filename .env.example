# Postgres (free tier: create a project at supabase.com, copy the connection
# string from Project Settings -> Database -> Connection string -> URI, and
# swap its "postgresql://" prefix for "postgresql+psycopg://")
DATABASE_URL=postgresql+psycopg://postgres:your-password@your-project.supabase.co:5432/postgres

# Encrypts stored Jira/Slack credentials at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=your_generated_fernet_key_here

# Every request resolves to this org until real accounts/auth exist.
# Run `python -m scripts.seed_default_org` after setting JIRA_* below to create it.
DEFAULT_ORG_SLUG=default

LLM_PROVIDER=ollama
# Options: openai, groq, gemini, ollama

# OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Groq (optional)
GROQ_API_KEY=your_groq_api_key_here

# Gemini (optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (local, no key needed)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2

# Slack Bot
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_APP_TOKEN=xapp-your-app-token
SLACK_BUGS_CHANNEL=bugs

# Jira — classic auth (used by scripts/seed_default_org.py). Fine for a single
# org, but the API token has no refresh mechanism: it just dies eventually
# (revoked, rotated, expired) with no warning. Prefer the OAuth vars below for
# anything meant to keep running unattended.
JIRA_BASE_URL=https://your-org.atlassian.net
JIRA_EMAIL=your-email@example.com
JIRA_API_TOKEN=your_jira_api_token
JIRA_PROJECT_KEY=BT

# Jira — OAuth 2.0 (3LO), self-refreshing. Register an app at
# https://developer.atlassian.com/console/myapps/ -> "Authorization" tab ->
# add the "Jira API" permission with scopes read:jira-work, write:jira-work,
# offline_access. Set its callback URL to match JIRA_OAUTH_REDIRECT_URI below.
# Then connect an org by visiting (while logged in as that org):
#   GET /integrations/jira/connect?project_key=BT
JIRA_OAUTH_CLIENT_ID=your_atlassian_oauth_client_id
JIRA_OAUTH_CLIENT_SECRET=your_atlassian_oauth_client_secret
JIRA_OAUTH_REDIRECT_URI=http://localhost:8000/integrations/jira/callback

# Signs the short-lived OAuth state token (CSRF protection for the connect flow).
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
OAUTH_STATE_SECRET=your_generated_random_secret_here
